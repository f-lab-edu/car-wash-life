{
  "description": "작업 완료 전 영속 모델 변경에 따른 ERD 갱신을 확인한다.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/erd_sync.py\"",
            "timeout": 10,
            "statusMessage": "ERD 갱신 필요 여부 확인"
          }
        ]
      }
    ]
  }
}
